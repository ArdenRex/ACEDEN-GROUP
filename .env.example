# AI Workflow Coordinator — marketing website environment
# Copy this file to .env.local for local development.
# This project holds no secrets: it's a static/SSR marketing site with
# no backend calls of its own, so every value here is public by design
# (hence the NEXT_PUBLIC_ prefix).

# Base URL of the product application. Every "Try it" / "Login" CTA on
# the marketing site routes here. Never hardcode this domain in code —
# always read it through src/lib/env.ts.
#
# Local dev example:      http://localhost:3000
# Production example:     https://<the app's actual Vercel domain>
NEXT_PUBLIC_APP_URL=https://app.example.com

# Canonical URL of this marketing site itself, used for metadata,
# Open Graph tags, and the sitemap. Set to https://acedengroup.com in
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
